# No secrets here. Credential is supplied by systemd LoadCredential.
MCP_BIND=127.0.0.1:8021
SYNC_SERVER_DATA_DIR=/srv/weimo-douban/data
# Required; every holder of the token can read ALL accounts listed here.
MCP_ALLOWED_UIDS=wenjun30
MCP_ALLOWED_HOSTS=weimo.ink
# Omit MCP_ALLOWED_ORIGINS to reject every request with Origin.
# Browser access also needs a separately designed CORS policy; not enabled here.
MCP_REQUESTS_PER_MINUTE=60
MCP_BURST=10
MCP_MAX_CONCURRENT=2
